# ============ 复制这个文件改名为 .env，再填入你自己的密钥 ============

# ========== 硅基流动（同时用于 chat 和 embedding）==========
# 申请地址：https://siliconflow.cn/  （有免费额度）
SILICONFLOW_API_KEY=sk-wkbrjvkqpspyqoewxzdxgotbpdzwxjtfjnutkcaiowrnusur
